{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://senso.dev/schemas/mqtt/payloads/device-inventory.v1.json",
  "title": "DEVICE_INVENTORY payload v1",
  "description": "Full list of sensors attached to the gateway at boot/periodically. Devices absent from the list are treated as disconnected (INIT-PLAN phase 0).",
  "type": "object",
  "additionalProperties": false,
  "required": ["devices"],
  "properties": {
    "devices": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["deviceId", "deviceType"],
        "properties": {
          "deviceId": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
          "deviceType": { "type": "string", "pattern": "^[A-Z0-9_]{2,32}$" },
          "capabilities": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["metric"],
              "properties": {
                "metric": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
                "unit": { "type": "string", "minLength": 1, "maxLength": 32 }
              }
            }
          }
        }
      }
    }
  }
}
